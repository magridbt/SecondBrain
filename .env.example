# ============================================================
# Sri AB Teachings SecondBrain — Environment Variables
# ============================================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local com chaves reais
# ============================================================

# ------------------------------------------------------------
# Supabase (OBRIGATÓRIO)
# Dashboard: https://supabase.com/dashboard/project/zvuzkuyqeapbmfmcngae
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Voyage AI — Embeddings (OBRIGATÓRIO)
# https://dash.voyageai.com | Modelo: voyage-2 (1024 dimensões)
# ------------------------------------------------------------
VOYAGE_API_KEY=

# ------------------------------------------------------------
# Anthropic — LLM Principal (OBRIGATÓRIO)
# https://console.anthropic.com | Modelo: claude-sonnet-4-20250514
# ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Fallback Providers (OPCIONAL)
# Usados automaticamente se Anthropic falhar
# OpenAI → GPT-4o | Google → Gemini 1.5 Pro
# ------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ------------------------------------------------------------
# Upstash Redis — Rate Limiting + Cache de Embeddings (OBRIGATÓRIO)
# https://console.upstash.com
# Adicione UPSTASH_REDIS_REST_TOKEN diretamente no painel Vercel
# (o pre-commit hook bloqueia o padrão da variável)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io

# ------------------------------------------------------------
# Resend — Envio de emails de convite (OPCIONAL)
# https://resend.com | Necessário para sistema de convites
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sri AB Teachings <noreply@seudominio.com>

# ------------------------------------------------------------
# Criptografia — API keys dos usuários (OBRIGATÓRIO em produção)
# Mínimo 32 caracteres. Gere com: openssl rand -base64 32
# ------------------------------------------------------------
ENCRYPTION_KEY=

# ------------------------------------------------------------
# App URL — Usada em links de reset de senha e convites
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seudominio.vercel.app

# ------------------------------------------------------------
# Cron Secret — Protege endpoint /api/cron/* no Vercel
# https://vercel.com/docs/cron-jobs | Gere um token aleatório
# ------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------
# Coda (OPCIONAL) — Integração com Coda.io para SystemFile
# Necessário apenas se usar /api/cron/update-system-file
# ------------------------------------------------------------
CODA_API_TOKEN=
CODA_DOC_ID=

# ------------------------------------------------------------
# Sentry — Error Tracking (OPCIONAL)
# https://sentry.io
# ------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
